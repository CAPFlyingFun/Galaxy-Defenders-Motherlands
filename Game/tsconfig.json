{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@charb/*": ["../Char_B/src/*"],
      "three": ["./node_modules/@types/three"],
      "three/*": ["./node_modules/@types/three/*"]
    }
  },
  "include": ["src"]
}
